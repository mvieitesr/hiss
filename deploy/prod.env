# Hiss — Environment config (committed, non-secret)
# POSTGRES_PASSWORD lives in deploy/prod.secret.env (ignored by Git): see deploy/secret.env.example.
COMPOSE_PROJECT_NAME=hiss-prod
IMAGE=ghcr.io/mvieitesr/hiss
IMAGE_TAG=0.1.0
APP_VERSION=0.1.0
APP_PORT=8003
FEATURE_LABEL_FILTERING=false
POSTGRES_DB=hiss
POSTGRES_USER=postgres
