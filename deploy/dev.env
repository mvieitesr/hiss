# Hiss — Environment config (committed, non-secret)
# DB password is injected at deploy time — never committed.
COMPOSE_PROJECT_NAME=hiss-dev
IMAGE=ghcr.io/mvieitesr/hiss
# Set both to the published SHA8 when deploying dev.
IMAGE_TAG=
APP_VERSION=
APP_PORT=8001
FEATURE_LABEL_FILTERING=true
POSTGRES_DB=hiss
POSTGRES_USER=postgres
