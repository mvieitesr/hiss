# Hiss — Environment config (committed, non-secret)
# POSTGRES_PASSWORD lives in deploy/dev.secret.env (ignored by Git): see deploy/secret.env.example.
# COMPOSE_PROJECT_NAME is mandatory: Compose has no default, so a command without this file cannot touch another environment.
COMPOSE_PROJECT_NAME=hiss-dev
IMAGE=ghcr.io/mvieitesr/hiss
# Set both to the published SHA8 when deploying dev.
IMAGE_TAG=
APP_VERSION=
APP_PORT=8001
FEATURE_LABEL_FILTERING=true
POSTGRES_DB=hiss
POSTGRES_USER=postgres
