# Hiss — Environment config (committed, non-secret)
# POSTGRES_PASSWORD lives in deploy/staging.secret.env (ignored by Git): see deploy/secret.env.example.
COMPOSE_PROJECT_NAME=hiss-staging
IMAGE=ghcr.io/mvieitesr/hiss
IMAGE_TAG=0.1.0-snapshot
APP_VERSION=0.1.0-snapshot
APP_PORT=8002
FEATURE_LABEL_FILTERING=true
POSTGRES_DB=hiss
POSTGRES_USER=postgres
