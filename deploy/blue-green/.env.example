# Hiss — blue-green demo env (example, non-secret)
# Copy to .env or pass via --env-file. POSTGRES_PASSWORD must be set at runtime.
COMPOSE_PROJECT_NAME=hiss-blue-green
IMAGE=ghcr.io/vieitesss/hiss
BLUE_TAG=0.1.0
GREEN_TAG=0.1.1
BLUE_GREEN_PORT=9000
ACTIVE_SLOT=blue
POSTGRES_DB=hiss
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
FEATURE_LABEL_FILTERING=true
